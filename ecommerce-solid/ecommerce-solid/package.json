{
  "name": "ecommerce-solid",
  "version": "1.0.0",
  "description": "Projeto legado para refatora\u00e7\u00e3o SOLID",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "node --import tsx prisma/seed.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "setup": "prisma generate && node scripts/prepare-db.cjs && prisma migrate deploy && node --import tsx prisma/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "express": "^4.21.0",
    "nodemailer": "^7.0.11",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.27",
    "@types/nodemailer": "^7.0.4",
    "prisma": "^6.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
